# ==============================================================================
# DEVMETASOL WEBSITE - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# In Vite, variables exposed to the client-side code must be prefixed with VITE_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI CHATBOT APIs (Gemini & Groq)
# ------------------------------------------------------------------------------
# Google Gemini
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemma-4-26b-a4b-it
VITE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Groq (Ultra-fast active model: openai/gpt-oss-120b)
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=openai/gpt-oss-120b
VITE_GROQ_API_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 2. BACKEND / REST API SERVICES
# ------------------------------------------------------------------------------
# Base URL for custom backend or microservices
VITE_API_BASE_URL=https://api.devmetasol.com
VITE_API_TIMEOUT=10000

# ------------------------------------------------------------------------------
# 3. CONTACT FORM & EMAIL DELIVERY APIS
# ------------------------------------------------------------------------------
# Custom Contact API endpoint
VITE_CONTACT_API_URL=https://api.devmetasol.com/api/contact

# Web3Forms API (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Formspree API (https://formspree.io)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# EmailJS Service (https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ------------------------------------------------------------------------------
# 4. CALENDLY & MEETING BOOKING API
# ------------------------------------------------------------------------------
# Consultation scheduling link (used in ScheduleCall / Consultations)
VITE_CALENDLY_URL=https://calendly.com/devmetasol/free-consultation

# ------------------------------------------------------------------------------
# 5. GOOGLE MAPS API
# ------------------------------------------------------------------------------
# Google Maps JavaScript / Embed API Key (https://console.cloud.google.com)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 6. ANALYTICS & TAG MANAGER APIS
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
VITE_GTM_ID=your_gtm_id

# ------------------------------------------------------------------------------
# 7. SITE & CONTACT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://devmetasol.com
VITE_COMPANY_EMAIL=careers@devmetasol.com
VITE_COMPANY_PHONE=+923320409566
VITE_WHATSAPP_NUMBER=923320409566
VITE_OFFICE_1="LUMS Incubation Center, Lahore, Pakistan"
VITE_OFFICE_2="Jumeirah Lake Towers, Dubai, UAE"
